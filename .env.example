# Copy to .env.local and fill in. Both are free-tier keys.
#
# These are the SERVER fallback keys (used for local dev and the sample flow).
# End users don't need them: the app supports bring-your-own-key from the UI
# (Keys button) - those live only in the user's browser and are sent per request.

# Groq - hosts Whisper for transcription. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini - the analysis LLM. Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
